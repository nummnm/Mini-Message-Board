<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
</head>
<body>
  <h1><%= title %></h1>

  <a href="/new">Add a new message</a>
  <% messages.forEach((message, index) => { %>
    <div class="message">
      <h2><%= message.user %></h2>
      <p><%= message.text %></p>
      <small><%= message.added %></small>
      <a href="/messages/<%= index %>">Open</a>
    </div>
  <% }) %>

</body>
</html>